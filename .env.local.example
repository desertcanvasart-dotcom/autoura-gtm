# ============================================================================
# autoura-growth — environment TEMPLATE
# Copy to .env.local and fill in. This .example file is committed to git, so it
# must contain ONLY placeholders — never real secrets. .env.local is gitignored.
# ============================================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the agent model (defaults to claude-sonnet-5).
GTM_AGENT_MODEL=claude-sonnet-5

# --- Supabase (SEPARATE project from autoura-saas) ---
# Project URL + anon key are safe for the browser; service-role is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-GTM-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Used by the chat API + admin to write/read gtm_ tables,
# bypassing RLS. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Widget embedding ---
# Space-separated list of origins allowed to embed /widget in an <iframe>.
# e.g. "https://getautoura.net https://www.getautoura.net"
# Until set, only same-origin can embed (nothing on the marketing site will show).
GTM_ALLOWED_FRAME_ANCESTORS='self'

# --- Escalation / notifications ---
# Escalated leads (spec §4 escalation rule) are flagged in /admin AND emailed
# here, once per lead, via Resend. Comma-separate multiple addresses.
GTM_ESCALATION_EMAIL=you@example.com
# Sender for alerts — must be on a domain verified in Resend. Falls back to
# OUTBOUND_FROM_EMAIL. Alerts also need RESEND_API_KEY (see Outbound below).
GTM_ALERT_FROM_EMAIL=Autoura Alerts <alerts@outreach.getautoura.net>
# Public URL of this app, for the "open transcript" link in alerts. Falls back
# to OUTBOUND_PUBLIC_BASE_URL.
GTM_PUBLIC_BASE_URL=https://autoura-growth-production.up.railway.app

# --- Admin view auth ---
# A password YOU invent (not from any provider) — a shared secret that gates
# /admin. Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# You'll type it as the password (any username) when the browser prompts at /admin.
ADMIN_ACCESS_TOKEN=change-me-to-a-long-random-string

# --- Booking ---
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/autoura

# --- Outbound (Phase 2, Slice A) ---
# Resend API key (same provider the main app uses). Leave blank in dry-run.
RESEND_API_KEY=
# Cold-send from identity. Use an outreach SUBDOMAIN (e.g. outreach.getautoura.net)
# separate from your transactional domain to protect its deliverability.
OUTBOUND_FROM_EMAIL=Name <you@outreach.getautoura.net>
# Replies route here (a sending subdomain doesn't receive mail). Use a real inbox.
OUTBOUND_REPLY_TO=you@getautoura.net
# Physical mailing address shown in the email footer (required for cold email).
OUTBOUND_POSTAL_ADDRESS=Autoura, <street>, <city>, <country>
# Absolute base URL for unsubscribe links (the growth app's public URL in prod).
OUTBOUND_PUBLIC_BASE_URL=https://autoura-growth-production.up.railway.app
# Secret for signing unsubscribe links. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OUTBOUND_UNSUB_SECRET=change-me
# SAFETY GATE: true = full pipeline but NO real email is sent. Flip to false to go live.
OUTBOUND_DRY_RUN=true
# --- Sequencing (Slice B) ---
# Protects /api/cron/outbound-followups. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=change-me
# Resend webhook signing secret (whsec_...) for bounce/complaint auto-suppression.
# From the Resend dashboard when you add the /api/outbound/resend-webhook endpoint.
RESEND_WEBHOOK_SECRET=
# In-app scheduler: true = the server itself drafts due follow-ups on an interval
# (no external cron needed). Alternatively hit /api/cron/outbound-followups yourself.
OUTBOUND_INTERNAL_CRON=false
OUTBOUND_INTERNAL_CRON_HOURS=6
# --- WhatsApp inbound (optional) ---
# meta | twilio. Unset = WhatsApp off. Same variable names as autoura-saas.
WHATSAPP_PROVIDER=
# Public URL of this app (Twilio signatures are over it; also used for links in alerts).
# GTM_PUBLIC_BASE_URL is set above under escalation alerts.
WHATSAPP_MAX_MESSAGES_PER_DAY=40
# Meta Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_API_KEY=
TWILIO_API_SECRET=
# --- LinkedIn (assisted) ---
# Max characters for drafted connection notes. 200 fits every LinkedIn account;
# use 300 if the sender's plan allows longer notes.
LINKEDIN_NOTE_MAX_CHARS=200
